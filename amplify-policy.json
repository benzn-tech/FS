{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::fsai-videos/*",
        "arn:aws:s3:::fsai-transcripts/*",
        "arn:aws:s3:::fsai-media/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::fsai-videos",
        "arn:aws:s3:::fsai-transcripts",
        "arn:aws:s3:::fsai-media"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["events:PutEvents"],
      "Resource": "arn:aws:events:ap-southeast-2:164088480050:event-bus/fieldsightai-events"
    },
    {
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": [
        "arn:aws:lambda:ap-southeast-2:164088480050:function:fieldsightai-export-to-aconex",
        "arn:aws:lambda:ap-southeast-2:164088480050:function:fieldsightai-export-to-safebase"
      ]
    }
  ]
}
